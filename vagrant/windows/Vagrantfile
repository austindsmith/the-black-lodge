# Work-laptop simulator and offline kit builder. See README.md.
#
#   builder  online, with MSVC: builds kit/ (pinned by its lock files) onto the USB
#            stick and installs it, so dotfiles can be sketched against the real thing
#   work     offline (isolated network), no toolchain: installs from the stick the
#            way the work laptop does, then smoke-tests it
#
# The stick is passed through to whichever VM is up, so run one at a time.
require_relative "config/settings"
require_relative "config/usb"

Vagrant.configure("2") do |config|
  config.vm.box = Settings::BOX
  config.vm.box_version = Settings::BOX_VERSION
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |libvirt|
    # Domains are kit-builder / kit-work (see `just usb-attach`, `just console`).
    libvirt.default_prefix = "kit-"
  end

  Usb.configure(config, Settings::USB_LABEL)

  # Runs one kit step (build/install/test) against the stick; see provision/kit.ps1.
  kit_step = lambda do |machine, action, env = {}|
    machine.vm.provision action, type: "shell", path: "provision/kit.ps1",
      env: { "KIT_ACTION" => action, "KIT_USB_LABEL" => Settings::USB_LABEL }.merge(env)
  end

  config.vm.define "builder", primary: true do |builder|
    builder.winrm.timeout = 7200 # the first Build Tools install is slow

    builder.vm.provider :libvirt do |libvirt|
      libvirt.cpus = 4
      libvirt.memory = 8192
    end

    git_name, git_email = Settings.git_identity
    builder.vm.provision "toolchain", type: "shell", path: "provision/builder.ps1",
      env: { "GIT_NAME" => git_name, "GIT_EMAIL" => git_email }

    # kit/ is small, so it's uploaded fresh (cleared first) rather than synced.
    builder.vm.provision "kit-clean", type: "shell",
      inline: "Remove-Item -Recurse -Force C:\\kit-src -ErrorAction SilentlyContinue"
    builder.vm.provision "kit-upload", type: "file",
      source: File.expand_path("kit", __dir__), destination: "C:/kit-src"

    kit_step.call(builder, "build", { "KIT_REVISION" => Settings.revision(File.expand_path("kit", __dir__)) })
    kit_step.call(builder, "install")
  end

  config.vm.define "work", autostart: false do |work|
    work.vm.provider :libvirt do |libvirt|
      # No <forward> on this network: the host reaches the guest, nothing else does.
      libvirt.management_network_name = "kit-offline"
      libvirt.management_network_address = "192.168.124.0/24"
      libvirt.management_network_mode = "none"
    end

    work.vm.provision "lockdown", type: "shell", path: "provision/work.ps1"
    kit_step.call(work, "install")
    kit_step.call(work, "test")
  end
end
