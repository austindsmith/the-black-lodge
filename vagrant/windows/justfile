set shell := ["bash", "-euo", "pipefail", "-c"]

usb := env("KIT_USB_LABEL", "portable")

# Prints all commands when running `just`
default:
    @just --list

# Pins kit/ inputs: app URLs + sha256, Python and npm lock files (--upgrade to bump deps)
lock *args:
    kit/lock.sh {{ args }}

# Lists apps with a newer upstream release than the locked one
outdated:
    kit/outdated.sh

# Brings up the online builder: toolchain, kit build onto the stick, install
builder:
    vagrant up builder

# Rebuilds the kit onto the stick (incremental) and reinstalls it in the builder
build:
    vagrant provision builder --provision-with kit-clean,kit-upload,build,install

# Brings up the offline work VM: installs from the stick and smoke-tests it
work:
    vagrant up work

# Re-runs the offline install and smoke test in the work VM
test:
    vagrant provision work --provision-with install,test

# Opens a VM's desktop (log in as worker/worker in the work VM)
console vm="builder":
    virt-manager --connect qemu:///system --show-domain-console kit-{{ vm }}

# Hot-plugs the stick into a running VM (e.g. it wasn't plugged in at `up`)
usb-attach vm="builder":
    scripts/usb.sh release {{ usb }}
    scripts/usb.sh xml {{ usb }} | virsh --connect qemu:///system attach-device kit-{{ vm }} /dev/stdin --live

# Destroys both VMs; the stick returns to the host
destroy:
    vagrant destroy --force
