set shell := ["bash", "-euo", "pipefail", "-c"]

usb := env("KIT_USB_LABEL", "portable")

[doc("Prints all commands when running `just`")]
default:
    @just --list

[doc("Validates the manifest, lock files, scripts and Vagrantfile")]
check:
    scripts/check.sh

[doc("Pins app urls and hashes plus the python and npm lock files (--upgrade bumps deps)")]
lock *args:
    scripts/lock.sh {{ args }}

[doc("Lists apps with a newer upstream release than the locked one")]
outdated:
    scripts/outdated.sh

[doc("Brings up the online builder: toolchain, kit build onto the stick, install")]
builder: check
    vagrant up builder

[doc("Rebuilds the kit onto the stick and reinstalls it in the builder")]
build: check
    vagrant provision builder --provision-with kit-clean,kit-upload,build,install

[doc("Brings up the offline work VM: installs from the stick and smoke-tests it")]
work:
    vagrant up work

[doc("Re-runs the offline install and smoke test in the work VM")]
test:
    vagrant provision work --provision-with install,test

[doc("Summarises what is currently on the USB stick")]
stick:
    scripts/stick.sh {{ usb }}

[doc("Opens a VM's desktop; log in as worker/worker on the work VM")]
console vm="builder":
    virt-manager --connect qemu:///system --show-domain-console kit-{{ vm }}

[doc("Hot-plugs the stick into a running VM")]
usb-attach vm="builder":
    scripts/usb.sh release {{ usb }}
    scripts/usb.sh xml {{ usb }} | virsh --connect qemu:///system attach-device kit-{{ vm }} /dev/stdin --live

[doc("Destroys both VMs; the stick returns to the host")]
destroy:
    vagrant destroy --force
